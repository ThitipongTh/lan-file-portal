# Host port; allow access only from your trusted LAN.
PORT=8080

# Host folder to share read-only. Relative paths resolve from compose.yaml.
# Create the directory before starting. Keep /srv/shared inside the container unchanged.
SHARE_PATH=./shared
# macOS: SHARE_PATH='/Users/yourname/AIMSLAB Shared'
# Linux: SHARE_PATH=/srv/aimslab/shared
# Windows Docker Desktop: SHARE_PATH='C:/AIMSLAB Shared'
# WSL: SHARE_PATH=/mnt/c/AIMSLAB-Shared
