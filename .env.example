# Host port; expose only on your trusted LAN.
PORT=8080

# Host folder to share. Mounted READ-WRITE so the admin can upload/delete.
# Create the directory before starting. Relative paths resolve from compose.yaml.
SHARE_PATH=./shared
# macOS: SHARE_PATH='/Users/yourname/AIMSLAB Shared'
# Linux: SHARE_PATH=/srv/aimslab/shared
# Windows Docker Desktop: SHARE_PATH='C:/AIMSLAB Shared'
# WSL: SHARE_PATH=/mnt/c/AIMSLAB-Shared

# Admin password. REQUIRED to enable the admin page (manage files + view speed).
# Leave blank to run download-only with no admin. Travels over plain HTTP:
# trusted LAN only.
ADMIN_PASSWORD=

# Optional. Signs admin session cookies. Set a long random value to keep admins
# logged in across restarts; if blank, a random one is generated each start.
SESSION_SECRET=

# Max upload size in bytes (default 2 GiB = 2147483648). Set 0 to disable.
MAX_UPLOAD_BYTES=2147483648

# The container runs as this user/group so it can write to SHARE_PATH.
# These MUST match the owner of SHARE_PATH. Find them with `id -u` / `id -g`
# (Linux/macOS). Defaults suit the first Linux user.
PUID=1000
PGID=1000
